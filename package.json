{
  "name": "pubmed-digest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "description": "Pull newly-published PubMed papers, score them against a personal interest profile with the Anthropic API, and deliver a top-matches digest via Telegram.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:digest": "tsx src/index.ts digest",
    "dev:search": "tsx src/index.ts search",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "types:worker": "wrangler types worker/worker-configuration.d.ts --config worker/wrangler.jsonc",
    "check:worker-types": "wrangler types worker/worker-configuration.d.ts --config worker/wrangler.jsonc --check",
    "state:repair": "tsx src/repair-state.ts",
    "eval": "tsx src/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.125.0",
    "fast-xml-parser": "5.11.1",
    "yaml": "2.9.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  }
}
